# Supabase (local dev — populated by `supabase start` output)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 楽天市場 API (https://webservice.rakuten.co.jp/)
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=

# Amazon アソシエイト (https://affiliate.amazon.co.jp/)
# 取得後、Amazon リンクに ?tag=YOUR-22 が自動付与される
NEXT_PUBLIC_AMAZON_TAG=

# バリューコマース (https://www.valuecommerce.ne.jp/)
# Yahoo!ショッピングの「広告(リンク)」から sid と pid を取得
NEXT_PUBLIC_VC_SID=
NEXT_PUBLIC_VC_PID=
